{
  "name": "astra-med",
  "private": true,
  "version": "1.0.0",
  "description": "ASTRA-MED \u2014 offline-first astronaut health monitoring console (NASA Space Apps Challenge 2026 prototype)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "donki:fallback": "node scripts/build-donki-fallback.mjs",
    "donki:check": "node scripts/check-donki.mjs",
    "qa:screenshots": "node scripts/qa-screenshots.mjs",
    "assets:fetch": "node scripts/fetch-offline-assets.mjs",
    "core:build": "vite build -c vite.core.config.ts && node scripts/copy-core.mjs",
    "core:cli": "node integrations/cli/astra-core.mjs",
    "voice:setup": "node \"scripts/setup-local-voice.mjs\"",
    "voice:setup:kokoro": "node \"scripts/setup-kokoro.mjs\"",
    "voice:local": "node \"integrations/voice/local-voice-server.mjs\"",
    "desktop:prepare": "npm run typecheck && vite build --outDir desktop/web --emptyOutDir && node scripts/desktop-prepare.mjs",
    "desktop:start": "npm run desktop:prepare && electron desktop",
    "desktop:dist:win": "npm run desktop:prepare && electron-builder --projectDir desktop --win",
    "desktop:dist:linux": "npm run desktop:prepare && electron-builder --projectDir desktop --linux",
    "pitch": "vite build && vite preview --open \"/?pitch\""
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "44.11.3",
    "electron-builder": "26.18.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
